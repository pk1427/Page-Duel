# Book People Admin — Staging Supabase (hosted project: book-people-staging)
# Copy to .env.local and fill in real values.
# NEVER add a secret/service-role key to this app.
# NEVER commit .env.local — it is git-ignored by .env*.local rule.

EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<STAGING_PUBLISHABLE_KEY>

# Hosted book gameplay assets (public HTTPS).
# The path must include the version so the base + relative path uniquely resolves.
# Format: https://<PROJECT_REF>.supabase.co/storage/v1/object/public/book-assets/books/<slug>/versions/<label>
EXPO_PUBLIC_BOOK_ASSET_BASE_URL=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/book-assets

EXPO_PUBLIC_BOOK_ASSET_BASE_URL_ALICE_LOC_1885=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/book-assets/books/alice-loc-1885/versions/1
EXPO_PUBLIC_BOOK_ASSET_BASE_URL_TALES_OF_PUNJAB_1894=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/book-assets/books/tales-of-punjab-1894/versions/1