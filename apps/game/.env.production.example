# Book People (player app) — Production Supabase.
# Copy to .env.production.local and fill in real values.
# NEVER add a secret/service-role key to this app.
# NEVER commit .env.production.local — it is git-ignored by .env*.local rule.

# Production Supabase project. The anon/publishable key is public by design;
# RLS enforces all data security. No service-role key ever enters this app.
EXPO_PUBLIC_SUPABASE_URL=https://<PROD_PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<PROD_PUBLISHABLE_KEY>

# Hosted book gameplay assets (public HTTPS Storage).
# The path must include the version so the base + relative path uniquely resolves.
# Format: https://<PROD_PROJECT_REF>.supabase.co/storage/v1/object/public/book-assets/books/<slug>/versions/<label>
EXPO_PUBLIC_BOOK_ASSET_BASE_URL=https://<PROD_PROJECT_REF>.supabase.co/storage/v1/object/public/book-assets

# Per-book overrides include the version path. The key is the book id
# (BookContent.id) uppercased with non-alphanumerics replaced by underscores.
EXPO_PUBLIC_BOOK_ASSET_BASE_URL_ALICE_LOC_1885=https://<PROD_PROJECT_REF>.supabase.co/storage/v1/object/public/book-assets/books/alice-loc-1885/versions/1
EXPO_PUBLIC_BOOK_ASSET_BASE_URL_TALES_OF_PUNJAB_1894=https://<PROD_PROJECT_REF>.supabase.co/storage/v1/object/public/book-assets/books/tales-of-punjab-1894/versions/1